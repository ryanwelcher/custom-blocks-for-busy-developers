{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "Custom Blocks for Busy Developers",
		"description": "Install the code for the workshop.",
		"author": "ryanwelcher",
		"categories": [ "block-editor" ]
	},
	"login": true,
	"steps": [
		{
			"step": "installPlugin",
			"options": {
				"activate": true,
				"targetFolderName": "custom-blocks-for-busy-developers"
			},
			"pluginData": {
				"resource": "git:directory",
				"url": "https://github.com/ryanwelcher/custom-blocks-for-busy-developers.git",
				"ref": "HEAD",
				"path": "/"
			}
		}
	]
}
